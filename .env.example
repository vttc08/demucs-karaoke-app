# Server configuration
HOST=0.0.0.0
PORT=8000

# Locale/languages
ENABLED_LOCALES=en,zh-CN

# Lyrics settings
MUSIXMATCH_TOKEN=
LASTFM_API_KEY=
LRCLIB_API_URL=https://lrclib.net
LYRICS_TTML_STORAGE_URL=https://lyrics-storage.binimum.org
LYRICS_TTML_UPGRADE_TIMEOUT_SECONDS=3.0
LYRICS_PROVIDER_CUSTOM_PATHS=

### ===============
# For local non-Docker deployment or if these environment variables aren't defined in
# your compose.yml, you'll need to uncomment and configure these variables.

# Optional reverse proxy subpath. Empty or / serves the app at /
# Example: KARAOKE_BASE_PATH=/karaoke
# KARAOKE_BASE_PATH=

# Database
# DATABASE_URL=sqlite:///./karaoke.db

# External tools (usually in PATH, can override)
# YTDLP_PATH=yt-dlp
# YTDLP_DENO_PATH=
# FFMPEG_PATH=ffmpeg

# Logging
# Set LOG_LEVEL=DEBUG while adding logger.debug statements; switch back to INFO for normal runs.
# LOG_LEVEL=INFO
# LOG_DIR=./logs
# LOG_FILE_NAME=karaoke.log
# LOG_MAX_BYTES=5242880
# LOG_BACKUP_COUNT=5
# LOG_TO_FILE_IN_RELOAD=false
## ===============


### ===============
# Environment variables and .env file loaded in Docker take precedence over settings in the application
# Therefore, even if you manually change the settings in app and save it
# the application defaults to value as configured in environment variables upon restarting.
# The environment is setup for easy development, hence why most settings are commented out
# because these can be changed in the WebUI and it's better to change it there
# where it will be persisted and not overridden.
# You can uncomment only if you wish to permanently set the value without changing it later.

# The values in these environment variables are the default if it's not changed. 
### ===============

# Media storage
# MEDIA_PATH=/tmp/karaoke_media
# CACHE_PATH=/tmp/karaoke_cache

# Demucs service
# DEMUCS_API_URL=http://demucs:8001
# DEMUCS_API_KEY=
# HEALTH_REQUEST_TIMEOUT_SECONDS=
# DEMUCS_MODEL=htdemucs
# DEMUCS_DEVICE=cuda
# DEMUCS_OUTPUT_FORMAT=wav
# DEMUCS_MP3_BITRATE=320
# SEPARATION_BACKEND=demucs
# SHERPA_SPLEETER_MODEL=fp16