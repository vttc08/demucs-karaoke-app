# Server configuration
HOST=0.0.0.0
PORT=8000
# Optional reverse proxy subpath. Empty or / serves the app at /
# Example: KARAOKE_BASE_PATH=/karaoke
KARAOKE_BASE_PATH=

# Media storage
MEDIA_PATH=/tmp/karaoke_media
CACHE_PATH=/tmp/karaoke_cache

# Demucs service
DEMUCS_API_URL=http://10.10.120.191:8001
DEMUCS_API_KEY=
HEALTH_REQUEST_TIMEOUT_SECONDS=5.0
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cuda
DEMUCS_OUTPUT_FORMAT=wav
DEMUCS_MP3_BITRATE=320
SEPARATION_BACKEND=demucs
SHERPA_SPLEETER_MODEL=fp16
LRCLIB_API_URL=https://lrclib.net
LYRICS_TTML_STORAGE_URL=https://lyrics-storage.binimum.org
LYRICS_TTML_UPGRADE_TIMEOUT_SECONDS=3.0
LASTFM_API_KEY=
LYRICS_PROVIDER_CUSTOM_PATHS=

# Database
DATABASE_URL=sqlite:///./karaoke.db

# External tools (usually in PATH, can override)
YTDLP_PATH=yt-dlp
YTDLP_DENO_PATH=
FFMPEG_PATH=ffmpeg

# Logging
# Set LOG_LEVEL=DEBUG while adding logger.debug statements; switch back to INFO for normal runs.
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE_NAME=karaoke.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_TO_FILE_IN_RELOAD=false

# Demucs on another PC
MAC_ADDRESS=9C:6B:00:2F:BE:AD
IP_ADDRESS=10.10.120.191
WORKSPACE_FOLDER=~/Documents/Projects/karaoke
HOSTNAME=desktop-iijbpb0
