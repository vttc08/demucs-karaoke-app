# Bind-mounted state is written directly as this numeric host user and group.
PUID=1000
PGID=1000
KARAOKE_DATA_DIR=./data
KARAOKE_PORT=8000

# The published lightweight image is used by default. Set this to a version,
# or vocal-sync tag when you want a different published variant.
KARAOKE_IMAGE=vttc08/demucs-karaoke-app:latest

DEMUCS_API_URL=http://demucs-host:8001
DEMUCS_API_KEY=
KARAOKE_BASE_PATH=
