# Bind-mounted state is written directly as this numeric host user and group.
PUID=1000
PGID=1000
KARAOKE_DATA_DIR=./data
KARAOKE_PORT=8000

# Use app for the lightweight image, or vocal-sync for NumPy/SciPy automatic
# guide-vocal offset estimation.
KARAOKE_BUILD_TARGET=app
KARAOKE_IMAGE=karaoke:latest

DEMUCS_API_URL=http://demucs-host:8001
DEMUCS_API_KEY=
KARAOKE_BASE_PATH=
