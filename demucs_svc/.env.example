# Demucs service configuration
# This file is read only by demucs_svc, not by the main karaoke app.

# Root folder for Demucs scratch files.
# Defaults to demucs_svc/io when unset.
DEMUCS_IO_ROOT=./io

# Optional Demucs defaults used by the service when requests omit values.
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cuda
DEMUCS_OUTPUT_FORMAT=wav
DEMUCS_MP3_BITRATE=320
SEPARATION_BACKEND=demucs

# Sherpa+Spleeter is CPU-only. Install model bundles with:
# uv run python -m demucs_svc.download_sherpa_models --variant fp16
SHERPA_SPLEETER_MODEL=fp16
SHERPA_SPLEETER_MODEL_ROOT=./model_data/sherpa_spleeter
SHERPA_SPLEETER_NUM_THREADS=8
SHERPA_SPLEETER_FFMPEG_PATH=ffmpeg
WHISPERX_TRANSCRIPTION_MODEL=tiny
WHISPERX_ALIGN_LANGUAGE=en
WHISPERX_DETECT_LANGUAGE=false
WHISPERX_USE_SYNCED_LYRICS=false
WHISPERX_PRELOAD_MODELS=transcription=tiny,align=en

# Memory cleanup tuning.
DEMUCS_GC_INTERVAL_SECONDS=600
DEMUCS_GC_LOW_FREE_VRAM_BYTES=2147483648
